      "input": "",
      "output": "",
      "comparison": "exact",
      "timeout": 1,
      "points": 20
    },
    {
      "name": "4.3 Löytyykö app.js src-kansiosta ja viittaus linectx?",
      "setup": "",
      "run": "test -f src/app.js && grep 'linectx' src/app.js",
      "input": "",
      "output": "",
      "comparison": "substring",
      "timeout": 1,
      "points": 20
    },
    {
      "name": "4.4 Onko index.html-tiedostossa canvas id:llä \"lineChart\">?",
      "setup": "",
      "run": "grep '<canvas id=\"lineChart\"' public/index.html",
      "input": "",
      "output": "",
      "comparison": "substring",
      "timeout": 1,
      "points": 20
    },
    {
      "name": "4.5 Onko app.js-tiedostossa koodia, joka luo kaavion Chart.js:llä?",
